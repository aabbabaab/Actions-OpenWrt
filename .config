CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7988=y
CONFIG_TARGET_mediatek_mt7988_DEVICE_bananapi_bpi-r4-pro-8x=y

# 简体中文
CONFIG_LUCI_LANG_zh-cn=y

# Argon主题
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-argon-config=y

# BPI‑BE14 MT7996 WiFi7支持
CONFIG_PACKAGE_kmod-mt7996=y
CONFIG_PACKAGE_firmware-mt7996=y
CONFIG_PACKAGE_wpad-full=y

# USB 5G模组驱动
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-net-qmi_wwan=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-xhci=y

# PCIe 5G模组支持
CONFIG_PACKAGE_kmod-pci=y
CONFIG_PACKAGE_kmod-pcie-mt7622=y

# 5G模组工具链（USB + PCIe模组）
CONFIG_PACKAGE_luci-app-3ginfo-modem=y
CONFIG_PACKAGE_3ginfo-modem=y
CONFIG_PACKAGE_modem-support=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_mbim-utils=y
CONFIG_PACKAGE_libmbim=y

# 基础LuCI & 工具
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_tcpdump=y

# 不使用默认bootstrap主题
CONFIG_PACKAGE_luci-theme-bootstrap=n
